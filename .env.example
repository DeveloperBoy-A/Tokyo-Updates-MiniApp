# Telegram bot token from @BotFather
BOT_TOKEN=
BOT_USERNAME=

# Public HTTPS URL of the deployed Mini App
WEBAPP_URL=https://your-service.onrender.com

# Optional MongoDB Atlas connection string
MONGODB_URI=
MONGODB_DATABASE=tokyo_updates

# Set true only when validating Telegram WebApp initData on backend
REQUIRE_TELEGRAM_AUTH=false
